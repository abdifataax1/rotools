{
  "name": "rotools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite client --host 0.0.0.0",
    "dev:server": "node --use-system-ca server/index.js",
    "build": "vite build client",
    "start": "node --use-system-ca server/index.js",
    "ingest": "node server/shorts/ingest.js",
    "test": "node --test server/shorts/**/*.test.js",
    "test:shorts": "node --test server/shorts/**/*.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.9",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "three": "^0.171.0",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
